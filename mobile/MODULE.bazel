bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True, repo_name = "buildifier")

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    java_toolchains,
    "remotejdk17_linux",
    "remotejdk17_linux_aarch64",
    "remotejdk17_macos",
    "remotejdk17_macos_aarch64",
    "remotejdk21_linux",
    "remotejdk21_linux_aarch64",
    "remotejdk21_macos",
    "remotejdk21_macos_aarch64",
)

register_toolchains(
    "//bazel:envoy_mobile_java_toolchain_linux_definition",
    "//bazel:envoy_mobile_java_toolchain_linux_aarch64_definition",
    "//bazel:envoy_mobile_java_toolchain_macos_definition",
    "//bazel:envoy_mobile_java_toolchain_macos_aarch64_definition",
    "//bazel:envoy_mobile_java11_toolchain_linux_default_definition",
    "//bazel:envoy_mobile_java11_toolchain_linux_aarch64_default_definition",
    "//bazel:envoy_mobile_java11_toolchain_macos_default_definition",
    "//bazel:envoy_mobile_java11_toolchain_macos_aarch64_default_definition",
    "//bazel:envoy_mobile_java11_toolchain_linux_definition",
    "//bazel:envoy_mobile_java11_toolchain_linux_aarch64_definition",
    "//bazel:envoy_mobile_java11_toolchain_macos_definition",
    "//bazel:envoy_mobile_java11_toolchain_macos_aarch64_definition",
    "//bazel:envoy_mobile_java_runtime_toolchain_linux",
    "//bazel:envoy_mobile_java_runtime_toolchain_linux_aarch64",
    "//bazel:envoy_mobile_java_runtime_toolchain_macos",
    "//bazel:envoy_mobile_java_runtime_toolchain_macos_aarch64",
    "//bazel:envoy_mobile_java_bootstrap_runtime_toolchain_linux",
    "//bazel:envoy_mobile_java_bootstrap_runtime_toolchain_linux_aarch64",
    "//bazel:envoy_mobile_java_bootstrap_runtime_toolchain_macos",
    "//bazel:envoy_mobile_java_bootstrap_runtime_toolchain_macos_aarch64",
)

local_path_override(
    module_name = "envoy",
    path = "..",
)

local_path_override(
    module_name = "envoy_api",
    path = "../api",
)

local_path_override(
    module_name = "envoy_build_config",
    path = "envoy_build_config",
)

single_version_override(
    module_name = "openssl",
    version = "3.5.7.envoy",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mobile_pip3",
    python_version = "3.12",
    requirements_lock = "//tools/python:requirements.txt",
)
use_repo(pip, "mobile_pip3")

envoy_repo_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_repo_extension")
use_repo(envoy_repo_ext, "envoy_repo")

envoy_build_config_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_build_config_ext")

override_repo(
    envoy_build_config_ext,
    envoy_build_config = "envoy_build_config",
)

mobile_platforms_ext = use_extension("//bazel:extensions.bzl", "envoy_mobile_platforms_extension")
use_repo(mobile_platforms_ext, "mobile_clang_platform")

llvm_toolchain_alias_ext = use_extension("@envoy_toolshed//compile:extensions.bzl", "llvm_toolchain_alias_extension")
use_repo(llvm_toolchain_alias_ext, "llvm_toolchain_llvm")

remote_android_extensions = use_extension(
    "@bazel_tools//tools/android:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_gmaven_r8", "android_tools")

android = use_extension("@hermetic-android-toolchains//:extensions.bzl", "android", dev_dependency = True)
android.sdk(
    build_tools_version = "35.0.0",
    version = "30",
)
android.ndk(
    api_level = 23,
    version = "r29",
)
use_repo(android, "androidndk", "androidsdk")

# Make @rules_android's @androidsdk labels resolve to the hermetic SDK.
rules_android_sdk = use_extension("@rules_android//rules/android_sdk_repository:rule.bzl", "android_sdk_repository_extension", dev_dependency = True)

override_repo(rules_android_sdk, "androidsdk")

# Make @rules_android_ndk's @androidndk labels resolve to the hermetic NDK.
rules_android_ndk = use_extension("@rules_android_ndk//:extension.bzl", "android_ndk_repository_extension", dev_dependency = True)

override_repo(rules_android_ndk, "androidndk")

register_toolchains(
    "@androidndk//:all",
    "@androidsdk//:all",
    dev_dependency = True,
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    artifacts = [
        "com.google.code.findbugs:jsr305:3.0.2",
        "androidx.annotation:annotation:1.5.0",
        "com.google.protobuf:protobuf-java:4.35.1",
        "com.google.protobuf:protobuf-javalite:4.35.1",
        "org.jetbrains:annotations:23.0.0",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8:2.4.20",
        "org.jetbrains.kotlin:kotlin-stdlib-common:2.4.20",
        "org.jetbrains.kotlin:kotlin-stdlib:2.4.20",
        "androidx.recyclerview:recyclerview:1.1.0",
        "androidx.core:core:1.3.2",
        "org.jetbrains.dokka:dokka-cli:1.5.31",
        "org.jetbrains.dokka:javadoc-plugin:1.5.31",
        "com.google.truth:truth:1.4.4",
        "junit:junit:4.13.2",
        "org.mockito:mockito-inline:5.2.0",
        "org.mockito:mockito-core:5.14.2",
        "com.squareup.okhttp3:okhttp:4.12.0",
        "com.squareup.okhttp3:mockwebserver:4.12.0",
        "io.netty:netty-all:4.1.115.Final",
        "androidx.test:core:1.5.0",
        "androidx.test:rules:1.5.0",
        "androidx.test:runner:1.5.0",
        "androidx.test:monitor:1.5.0",
        "androidx.test.ext:junit:1.1.5",
        "org.robolectric:robolectric:4.17",
        "org.hamcrest:hamcrest:3.0",
    ],
    known_contributing_modules = ["protobuf"],
    repositories = [
        "https://repo1.maven.org/maven2",
        "https://maven.google.com",
    ],
    version_conflict_policy = "pinned",
)
use_repo(maven, "maven")

maven.artifact(
    name = "rules_android_maven",
    artifact = "protobuf-java",
    force_version = True,
    group = "com.google.protobuf",
    version = "4.35.1",
)

# This pin is only for rules_android_maven's own tooling; it is intentionally independent from the
# @android_gmaven_r8 D8 used in mobile/bazel/android_artifacts.bzl to desugar the published aar.
maven.artifact(
    name = "rules_android_maven",
    artifact = "r8",
    force_version = True,
    group = "com.android.tools",
    version = "9.1.43",
)

# This is to workaround upstream bug/noise
maven.install(
    name = "rules_android_maven",
    known_contributing_modules = ["rules_android"],
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
)

extra_sources = use_extension("//bazel:extensions.bzl", "envoy_mobile_extra_sources_extension")
use_repo(extra_sources, "envoy_mobile_extra_jni_deps", "envoy_mobile_extra_swift_sources")

quiche = use_extension("@quiche//:extensions.bzl", "quiche")
quiche.deps(
    mobile_quiche_bug_tracker_impl_lib = "@envoy//source/common/quic/platform:quiche_logging_impl_lib",
)

quiche_dev = use_extension("@quiche//:extensions.bzl", "quiche", dev_dependency = True)
quiche_dev.deps(
    quiche_expect_bug_impl_lib = "@envoy//test/common/quic/platform:quiche_expect_bug_impl_lib",
    quiche_test_helpers_impl_lib = "@envoy//test/common/quic/platform:quiche_test_helpers_impl_lib",
    quiche_test_impl_lib = "@envoy//test/common/quic/platform:quiche_test_impl_lib",
    quiche_test_output_impl_lib = "@envoy//test/common/quic/platform:quiche_test_output_impl_lib",
    quiche_thread_impl_lib = "@envoy//test/common/quic/platform:quiche_thread_impl_lib",
)

