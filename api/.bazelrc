
common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/309345b942e43734d88ef9f3455402d86885cebe

# Java runtime configuration for bzlmod
# Use remote JDK to avoid dependency on local Java installation
build --java_runtime_version=remotejdk_11
build --tool_java_runtime_version=remotejdk_11

# Build settings
build --incompatible_strict_action_env
