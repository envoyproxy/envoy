events {
  downstream_send_event {
    h2_frames { settings { flags: NONE } }
    h2_frames { settings { flags: ACK } }
    h2_frames { request { stream_index: 1 host: "host" path: "/path" } }
    h2_frames {
      metadata {
        flags: END_METADATA
        stream_index: 0
        metadata { metadata { key: "conn-key" value: "conn-value" } }
      }
    }
  }
}
events {
  upstream_send_event {
    h2_frames { settings { flags: NONE } }
    h2_frames { settings { flags: ACK } }
  }
}