common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/429f95e660024dce57dfc764c3eb4a01a5e4e27e

common --noincompatible_disallow_empty_glob

# Bazel 9 migration flags; keep in sync with //:.bazelrc (this file does not import it).
# TODO(jwendell): remove once all external modules have explicit loads.
common --incompatible_autoload_externally=+@rules_cc,+@rules_python,+java_common,+JavaInfo,+JavaPluginInfo,ProguardSpecProvider,java_binary,java_import,java_library,java_plugin,java_test,java_runtime,java_toolchain,java_package_configuration,@com_google_protobuf,@rules_shell,+@rules_android
# TODO(jwendell): migrate the relevant variables to --repo_env and remove this.
common --noincompatible_repo_env_ignores_action_env
build --features=system_include_paths --host_features=system_include_paths
common --noincompatible_disallow_ctx_resolve_tools

common --@rules_python//python/config_settings:bootstrap_impl=script
common --@protobuf//bazel/flags:prefer_prebuilt_protoc=true
common --incompatible_enable_proto_toolchain_resolution

try-import %workspace%/../../../ci.bazelrc
try-import %workspace%/../../../user.bazelrc
