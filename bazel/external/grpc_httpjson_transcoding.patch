+TEST_F(RequestWeaverTest, CollisionInt64NoTruncation) {
+  // 4294967297 == (1LL << 32) + 1, which truncates to 1 modulo 2^32.
+  Bind("A.int64_field", "4294967297");
+  Bind("A.uint64_field", "4294967297");
+
+  expect_.StartObject("");
+  expect_.StartObject("A");
+  expect_.RenderInt64("int64_field", 4294967297LL);
+  expect_.RenderUint64("uint64_field", 4294967297ULL);
+  expect_.RenderInt64("int64_field", 1LL);
+  expect_.RenderUint64("uint64_field", 1ULL);
+  expect_.EndObject();  // "A"
+  expect_.EndObject();  // ""
+
+  auto w = Create(true);
+
+  w->StartObject("");
+  w->StartObject("A");
+  w->RenderInt64("int64_field", 4294967297LL);
+  EXPECT_EQ(w->Status().code(), absl::StatusCode::kOk);
+  w->RenderUint64("uint64_field", 4294967297ULL);
+  EXPECT_EQ(w->Status().code(), absl::StatusCode::kOk);
+  w->RenderInt64("int64_field", 1LL);
+  EXPECT_EQ(w->Status().code(), absl::StatusCode::kInvalidArgument);
+  EXPECT_THAT(
+      w->Status().ToString(),
+      HasSubstr("The binding value \"4294967297\" of the field int64_field is "
+                "conflicting with the value 1 in the body."));
+  w->RenderUint64("uint64_field", 1ULL);
+  EXPECT_THAT(
+      w->Status().ToString(),
+      HasSubstr("The binding value \"4294967297\" of the field uint64_field is "
+                "conflicting with the value 1 in the body."));
+  w->EndObject();  // "A"
+  w->EndObject();  // ""
+}
+
+TEST_F(RequestWeaverTest, CollisionDoubleNoFloatNarrowing) {
+  // 16777216 (2^24) and 16777217 (2^24 + 1, or 1.6777217E7) round to the same
+  // 32-bit float (16777216.0f), but are distinct 64-bit doubles.
+  Bind("A.double_field", "16777216");
+
+  expect_.StartObject("");
+  expect_.StartObject("A");
+  expect_.RenderDouble("double_field", 16777216.0);
+  expect_.RenderDouble("double_field", 16777217.0);
+  expect_.EndObject();  // "A"
