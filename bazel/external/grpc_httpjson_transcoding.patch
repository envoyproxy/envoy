+TEST_F(RequestWeaverTest, CollisionReportedCamelCaseJsonName) {
+  Bind("author_info.first_name", "Leo");
+
+  expect_.StartObject("");
+  expect_.StartObject("authorInfo");
+  expect_.RenderString("firstName", "Fyodor");
+  expect_.EndObject();  // "authorInfo"
+  expect_.EndObject();  // ""
+
+  auto w = Create(true);
+
+  w->StartObject("");
+  w->StartObject("authorInfo");
+  w->RenderString("firstName", "Fyodor");
+  EXPECT_EQ(w->Status().code(), absl::StatusCode::kInvalidArgument);
+  EXPECT_THAT(w->Status().ToString(),
+              HasSubstr("The binding value \"Leo\" of the field firstName is "
+                        "conflicting with the value \"Fyodor\" in the body."));
+  w->EndObject();  // "authorInfo"
+  w->EndObject();  // ""
+}
