+bool RequestWeaver::WeaveInfo::HasPendingBindings() const {
+  for (const auto& b : bindings) {
+    if (!b.done) {
+      return true;
+    }
+  }
+  for (const auto& msg : messages) {
+    if (msg.second.HasPendingBindings()) {
+      return true;
+    }
+  }
+  return false;
+}
